{
  "fixed-center": true,
  "layer": "top",
  "position": "top",
  "modules-left": [
    "custom/tailscale",
    "tray",
    "hyprland/workspaces",
    "hyprland/window"
  ],

  "modules-center": [
    "clock",
    "custom/logo",
    "custom/date"
  ],

  "modules-right": [
    "temperature",
    "cpu",
    "memory",
    "pulseaudio",
    "backlight",
    "custom/battery",
    "custom/osk",
    "custom/power"
  ],

  "hyprland/workspaces": {
		"disable-scroll-wraparound": true,
		"smooth-scrolling-threshold": 4,
		"enable-bar-scroll": true,
		"format": "{name}"
	},

	"hyprland/window": {
		"format": "{}",
		"max-length": 30,
		"tooltip": false
	},

  "custom/logo": {
    "on-click": "~/.config/quickshell/scripts/deck-toggle.sh",
    "on-click-right": "~/.config/quickshell/scripts/search-toggle.sh",
    "format": " ◈ PALANTÍR ",
    "tooltip": "",
    "fixed-center": true
  },

  "custom/osk": {
    "format": "",
    "tooltip": "Toggle On-Screen Keyboard",
    "on-click": "qs ipc call osk toggle"
  },

  "custom/tailscale": {
      "exec": "~/.config/waybar/scripts/tailscale-status.sh",
      "return-type": "json",
      "interval": 20,
      "on-click": "~/.config/waybar/scripts/tailscale-toggle.sh",
      "tooltip": true
  },

  "clock": {
    "interval": 60,
    "format": " {:%H:%M}"
  },

  "custom/date": {
    "exec": "date +\\ %d-%m",
    "interval": 60,
    "tooltip": false
  },

  "cpu": {
    "format": " {usage}%",
    "tooltip": false
  },

  "memory": {
    "format": " {percentage}%",
    "tooltip": false
  },

  "temperature": {
    "interval": 10,
    "format": " {temperatureC}°C"
  },

  "custom/battery": {
    "exec": "~/.config/waybar/scripts/battery.sh",
    "interval": 10,
    "return-type": "json",
    "tooltip": false
  },

  "pulseaudio": {
    "format": "\ud83d\udd0a {volume}%",
    "format-muted": "\ud83d\udd07 MUTE"
  },

  "network": {
    "interface": "wlp2s0",
    "format": "{ifname}",
    "format-wifi": "",
    "format-ethernet": "󰊗",
    "format-disconnected": ""
  },

  "bluetooth": 
  { "format": " {status}",
    "format-disabled": "", 
    "on-click": "bluetooth-manager"
   }, 

  "backlight": {
    "device": "intel_backlight",
    "format": "{percent}% {icon}",
    "format-icons": ["", ""]
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": "Power menu (confirmation required)",
    "on-click": "~/.config/quickshell/scripts/power-menu.sh",
    "interval": 3600
  }
}
