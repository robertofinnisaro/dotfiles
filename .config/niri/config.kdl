// ORTHANC / niri
// https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction
// Check changes with: niri validate

////////////////
/// MONITORS ///
////////////////

output "eDP-1" {
    scale 1
}

/////////////
/// INPUT ///
/////////////

input {
    keyboard {
        xkb {
            layout "gb"
        }
        numlock
        repeat-delay 250
        repeat-rate 35
    }

    touchpad {
        tap
        scroll-factor 0.7
    }

    touch {
        map-to-output "eDP-1"
    }

    tablet {
        map-to-output "eDP-1"
        left-handed
    }

    focus-follows-mouse
}

/////////////////////
/// LOOK AND FEEL ///
/////////////////////

prefer-no-csd

layout {
    gaps 8
    // Transparent so the wallpaper shows through; see the layer-rule below.
    background-color "transparent"
    center-focused-column "never"
    default-column-width { proportion 1.0; }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    focus-ring {
        off
    }

    border {
        width 2
        active-color "#c8a969dd"
        inactive-color "#3f645688"
        urgent-color "#9b0000"
    }

    shadow {
        on
        softness 30
        offset x=0 y=6
        color "#7bc6a922"
    }
}

overview {
    backdrop-color "#0b1519"
}

cursor {
    xcursor-size 24
}

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

window-rule {
    // Ignore maximize requests when apps open, so they keep their gaps.
    open-maximized-to-edges false

    geometry-corner-radius 18
    clip-to-geometry true

    background-effect {
        blur true
    }
}

window-rule {
    match is-active=true
    opacity 0.97
}

window-rule {
    match is-active=false
    opacity 0.88
}

// Keep the wallpaper visible behind the overview.
layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

///////////////////////////////
/// WINDOWS AND WORKSPACES  ///
///////////////////////////////

// Named by purpose. Rivendell and Mordor share their names with the matching
// performance realms, which are still chosen by hand in the Palantir.
workspace "rivendell" // dev
workspace "bree"      // browser
workspace "mordor"    // gaming
workspace "gondor"    // notes
workspace "shire"     // general, no assigned apps
// Stands in for Hyprland's special workspace; see scripts/scratchpad.sh.
workspace "magic"

window-rule {
    match app-id="^com\\.anthropic\\.Claude$"
    match app-id="^(codium|VSCodium)$"
    match app-id="^MATLAB"
    match title="^MATLAB R[0-9]"
    open-on-workspace "rivendell"
}

window-rule {
    match app-id="^brave-browser$"
    open-on-workspace "bree"
}

window-rule {
    match app-id="^steam$"
    match app-id="^steam_app_"
    match app-id="^org\\.prismlauncher\\.PrismLauncher$"
    match app-id="^Minecraft"
    open-on-workspace "mordor"
}

window-rule {
    match app-id="^(obsidian|md\\.obsidian\\.Obsidian)$"
    open-on-workspace "gondor"
}

// Take the view along when one of those apps is opened, so it isn't left out of
// sight. Not at login, and not for pop-ups such as Steam's friend notifications.
window-rule {
    match app-id="^com\\.anthropic\\.Claude$"
    match app-id="^(codium|VSCodium)$"
    match title="^MATLAB R[0-9]"
    match app-id="^brave-browser$"
    match app-id="^steam$" title="^Steam$"
    match app-id="^steam_app_"
    match app-id="^org\\.prismlauncher\\.PrismLauncher$"
    match app-id="^Minecraft"
    match app-id="^(obsidian|md\\.obsidian\\.Obsidian)$"
    exclude at-startup=true
    open-focused true
}

// --- MATLAB popup menus/dialogs: float ---
window-rule {
    match app-id="^MATLAB" title="^$"
    match title="^Add to Path$"
    match title="^Preferences$"
    match title="^Open File$"
    open-floating true
}

///////////////////////////
/// ENVIRONMENT         ///
///////////////////////////

// niri does not expand variables here, so the agent socket path uses the uid directly.
environment {
    QT_QPA_PLATFORM "wayland"
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_AUTO_SCREEN_SCALE_FACTOR "0"
    QT_SCALE_FACTOR "1"
    GDK_SCALE "1"
    GDK_DPI_SCALE "1"
    SSH_AUTH_SOCK "/run/user/1000/ssh-agent.socket"
}

/////////////////
/// AUTOSTART ///
/////////////////

// nm-applet and blueman-applet are not listed: niri.service starts them from /etc/xdg/autostart.
spawn-at-startup "swaybg" "-m" "fill" "-i" "/home/robertofinnisaro/Pictures/Wallpapers/wallpaper-orthanc.jpg"
spawn-sh-at-startup "waybar -c ~/.config/waybar/config-niri"
spawn-at-startup "~/.config/hypr/scripts/palantir-session.sh"
spawn-at-startup "steam" "-silent"
spawn-at-startup "discord" "--start-minimized" "--ozone-platform-hint=wayland"
spawn-at-startup "gnome-keyring-daemon" "--start" "--components=secrets"
spawn-at-startup "fw-fanctrl-gui" "--background"

///////////////////
/// KEYBINDINGS ///
///////////////////

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Return { spawn "alacritty"; }
    Mod+E { spawn "pcmanfm-qt"; }
    Mod+B { spawn "brave"; }
    Mod+Shift+B { spawn "brave" "--incognito"; }
    Mod+Q repeat=false { close-window; }
    Mod+M { quit; }
    Mod+V { toggle-window-floating; }
    Mod+L { spawn "hyprlock"; }
    Mod+Shift+L allow-when-locked=true { spawn-sh "systemctl hibernate || loginctl suspend"; }

    // Palantir: routed through Quickshell IPC, the same as on Hyprland.
    Mod+D { spawn "~/.config/quickshell/scripts/palantir-action.sh" "deck"; }
    Mod+G { spawn "~/.config/quickshell/scripts/palantir-action.sh" "overlay"; }
    Mod+K { spawn "~/.config/quickshell/scripts/palantir-action.sh" "keyboard"; }
    Mod+Shift+C { spawn "~/.config/quickshell/scripts/palantir-action.sh" "clipboard"; }
    Mod+Space { spawn "~/.config/quickshell/scripts/palantir-action.sh" "launcher"; }
    Mod+Print { spawn "~/.config/quickshell/scripts/capture-region.sh"; }
    Mod+Tab repeat=false { toggle-overview; }

    // Move focus with Mod + arrow keys
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }

    // Move the focused column or window
    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up { move-window-up; }
    Mod+Ctrl+Down { move-window-down; }

    // Column layout
    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Ctrl+F { maximize-window-to-edges; }
    Mod+C { center-column; }
    Mod+Comma { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // Switch workspace with Mod + [1-5]
    Mod+1 { focus-workspace "rivendell"; }
    Mod+2 { focus-workspace "bree"; }
    Mod+3 { focus-workspace "mordor"; }
    Mod+4 { focus-workspace "gondor"; }
    Mod+5 { focus-workspace "shire"; }

    // Move the focused window to a workspace with Mod + Shift + [1-5]
    Mod+Shift+1 { move-window-to-workspace "rivendell"; }
    Mod+Shift+2 { move-window-to-workspace "bree"; }
    Mod+Shift+3 { move-window-to-workspace "mordor"; }
    Mod+Shift+4 { move-window-to-workspace "gondor"; }
    Mod+Shift+5 { move-window-to-workspace "shire"; }

    // Scratchpad
    Mod+S { spawn "~/.config/niri/scripts/scratchpad.sh"; }
    Mod+Shift+S { move-window-to-workspace "magic" focus=false; }

    // Scroll through workspaces with Mod + scroll
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }

    // Laptop multimedia keys for volume and LCD brightness
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "-e4" "-n2" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "-e4" "-n2" "set" "5%-"; }

    // Requires playerctl
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
}
