// ORTHANC / niri
// https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction
// Check changes with: niri validate

////////////////
/// MONITORS ///
////////////////

output "eDP-1" {
    scale 1
}

/////////////
/// INPUT ///
/////////////

input {
    keyboard {
        xkb {
            layout "gb"
        }
        numlock
        repeat-delay 250
        repeat-rate 35
    }

    touchpad {
        tap
        scroll-factor 0.7
    }

    touch {
        map-to-output "eDP-1"
    }

    tablet {
        map-to-output "eDP-1"
        left-handed
    }

    focus-follows-mouse
}

/////////////////////
/// LOOK AND FEEL ///
/////////////////////

prefer-no-csd

layout {
    gaps 8
    // Transparent so the wallpaper shows through; see the layer-rule below.
    background-color "transparent"
    center-focused-column "never"
    default-column-width { proportion 1.0; }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    focus-ring {
        off
    }

    border {
        width 2
        active-color "#c8a969dd"
        inactive-color "#3f645688"
        urgent-color "#9b0000"
    }

    shadow {
        on
        softness 30
        offset x=0 y=6
        color "#7bc6a922"
    }
}

overview {
    backdrop-color "#0b1519"
}

cursor {
    xcursor-size 24
}

// Hyprland had none, and the top-left corner is easy to reach on the way to Waybar.
gestures {
    hot-corners {
        off
    }
}

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

window-rule {
    // Ignore maximize requests when apps open, so they keep their gaps.
    open-maximized-to-edges false

    geometry-corner-radius 18
    clip-to-geometry true

    background-effect {
        blur true
    }
}

window-rule {
    match is-active=true
    opacity 0.97
}

window-rule {
    match is-active=false
    opacity 0.88
}

// Keep the wallpaper visible behind the overview.
layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

///////////////////////////////
/// WINDOWS AND WORKSPACES  ///
///////////////////////////////

// Named by purpose. Rivendell and Mordor share their names with the matching
// performance realms, which are still chosen by hand in the Palantir.
workspace "rivendell" // dev
workspace "bree"      // browser
workspace "mordor"    // gaming
workspace "gondor"    // notes
workspace "shire"     // general, no assigned apps
// Stands in for Hyprland's special workspace; see scripts/scratchpad.sh.
workspace "magic"

window-rule {
    match app-id="^com\\.anthropic\\.Claude$"
    match app-id="^(codium|VSCodium)$"
    match app-id="^MATLAB"
    match title="^MATLAB R[0-9]"
    open-on-workspace "rivendell"
}

window-rule {
    match app-id="^brave-browser$"
    open-on-workspace "bree"
}

window-rule {
    match app-id="^steam$"
    match app-id="^steam_app_"
    match app-id="^org\\.prismlauncher\\.PrismLauncher$"
    match app-id="^Minecraft"
    match app-id="^parsecd$"
    open-on-workspace "mordor"
}

window-rule {
    match app-id="^(obsidian|md\\.obsidian\\.Obsidian)$"
    open-on-workspace "gondor"
}

// Take the view along when one of those apps is opened, so it isn't left out of
// sight. Not at login, and not for pop-ups such as Steam's friend notifications.
window-rule {
    match app-id="^com\\.anthropic\\.Claude$"
    match app-id="^(codium|VSCodium)$"
    match title="^MATLAB R[0-9]"
    match app-id="^brave-browser$"
    match app-id="^steam$" title="^Steam$"
    match app-id="^steam_app_"
    match app-id="^org\\.prismlauncher\\.PrismLauncher$"
    match app-id="^Minecraft"
    match app-id="^parsecd$"
    match app-id="^(obsidian|md\\.obsidian\\.Obsidian)$"
    exclude at-startup=true
    open-focused true
}

// --- MATLAB popup menus/dialogs: float ---
window-rule {
    match app-id="^MATLAB" title="^$"
    match title="^Add to Path$"
    match title="^Preferences$"
    match title="^Open File$"
    open-floating true
}

///////////////////////////
/// ENVIRONMENT         ///
///////////////////////////

// niri does not expand variables here, so the agent socket path uses the uid directly.
environment {
    QT_QPA_PLATFORM "wayland"
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_AUTO_SCREEN_SCALE_FACTOR "0"
    QT_SCALE_FACTOR "1"
    GDK_SCALE "1"
    GDK_DPI_SCALE "1"
    SSH_AUTH_SOCK "/run/user/1000/ssh-agent.socket"
}

/////////////////
/// AUTOSTART ///
/////////////////

// nm-applet and blueman-applet are not listed: niri.service starts them from /etc/xdg/autostart.
spawn-at-startup "swaybg" "-m" "fill" "-i" "/home/robertofinnisaro/Pictures/Wallpapers/wallpaper-orthanc.jpg"
spawn-sh-at-startup "waybar -c ~/.config/waybar/config-niri"
spawn-at-startup "~/.config/hypr/scripts/palantir-session.sh"
spawn-at-startup "~/.config/framework/auto-rotate.sh"
// Lock after 10 minutes idle and before sleep; screen off after 15.
spawn-at-startup "swayidle" "-w" "timeout" "600" "~/.config/niri/scripts/lock.sh" "timeout" "900" "niri msg action power-off-monitors" "before-sleep" "~/.config/niri/scripts/lock.sh" "lock" "~/.config/niri/scripts/lock.sh"
spawn-at-startup "steam" "-silent"
spawn-at-startup "discord" "--start-minimized" "--ozone-platform-hint=wayland"
spawn-at-startup "gnome-keyring-daemon" "--start" "--components=secrets"
spawn-at-startup "fw-fanctrl-gui" "--background"

// The hinge sensor reports tablet mode; palantir-framework12.py does the rotating.
switch-events {
    tablet-mode-on { spawn "sh" "-c" "python3 ~/.config/framework/palantir-framework12.py switch tablet"; }
    tablet-mode-off { spawn "sh" "-c" "python3 ~/.config/framework/palantir-framework12.py switch laptop"; }
}

///////////////////
/// KEYBINDINGS ///
///////////////////

binds {
    // Apps and session
    Mod+Slash hotkey-overlay-title="Open this list of keybinds" { spawn "~/.config/quickshell/scripts/palantir-action.sh" "keys"; }
    Mod+Shift+Slash hotkey-overlay-title="Show niri's own keybind overlay" { show-hotkey-overlay; }
    Mod+Return hotkey-overlay-title="Terminal" { spawn "alacritty"; }
    Mod+E hotkey-overlay-title="File manager" { spawn "pcmanfm-qt"; }
    Mod+B hotkey-overlay-title="Brave" { spawn "brave"; }
    Mod+Shift+B hotkey-overlay-title="Brave, private window" { spawn "brave" "--incognito"; }
    Mod+L hotkey-overlay-title="Lock the screen" { spawn "hyprlock"; }
    Mod+Shift+L allow-when-locked=true hotkey-overlay-title="Sleep" { spawn-sh "systemctl suspend"; }
    Mod+M hotkey-overlay-title="Log out of niri" { quit; }

    // Palantir panels
    Mod+D hotkey-overlay-title="The Palantir" { spawn "~/.config/quickshell/scripts/palantir-action.sh" "deck"; }
    Mod+G hotkey-overlay-title="The Field Atlas" { spawn "~/.config/quickshell/scripts/palantir-action.sh" "overlay"; }
    Mod+A hotkey-overlay-title="The Map of Middle-earth" { spawn "~/.config/quickshell/scripts/palantir-action.sh" "map"; }
    Mod+W hotkey-overlay-title="The Seeing Stone" { spawn "~/.config/quickshell/scripts/palantir-action.sh" "stone"; }
    Mod+K hotkey-overlay-title="On-screen keyboard" { spawn "~/.config/quickshell/scripts/palantir-action.sh" "keyboard"; }
    Mod+Space hotkey-overlay-title="Search and launch apps" { spawn "~/.config/quickshell/scripts/palantir-action.sh" "launcher"; }
    Mod+Shift+C hotkey-overlay-title="Clipboard history" { spawn "~/.config/quickshell/scripts/palantir-action.sh" "clipboard"; }
    Mod+Print hotkey-overlay-title="Screenshot an area" { spawn "~/.config/quickshell/scripts/capture-region.sh"; }

    // Windows
    Mod+Q repeat=false hotkey-overlay-title="Close window" { close-window; }
    Mod+V hotkey-overlay-title="Float or tile window" { toggle-window-floating; }
    Mod+F hotkey-overlay-title="Maximize, full width with gaps" { maximize-column; }
    Mod+Ctrl+F hotkey-overlay-title="Maximize, edge to edge" { maximize-window-to-edges; }
    Mod+Shift+F hotkey-overlay-title="Fullscreen, covers Waybar" { fullscreen-window; }
    Mod+H hotkey-overlay-title="Hide or show all windows" { spawn "~/.config/niri/scripts/show-desktop.sh"; }
    Mod+Tab repeat=false hotkey-overlay-title="Overview of all workspaces" { toggle-overview; }
    Mod+Shift+T hotkey-overlay-title="Switch tablet or laptop mode" { spawn-sh "python3 ~/.config/framework/palantir-framework12.py mode toggle"; }

    // Move focus
    Mod+Left hotkey-overlay-title="Focus column to the left" { focus-column-left; }
    Mod+Right hotkey-overlay-title="Focus column to the right" { focus-column-right; }
    Mod+Up hotkey-overlay-title="Focus window above" { focus-window-up; }
    Mod+Down hotkey-overlay-title="Focus window below" { focus-window-down; }

    // Move windows
    Mod+Ctrl+Left hotkey-overlay-title="Move column left" { move-column-left; }
    Mod+Ctrl+Right hotkey-overlay-title="Move column right" { move-column-right; }
    Mod+Ctrl+Up hotkey-overlay-title="Move window up" { move-window-up; }
    Mod+Ctrl+Down hotkey-overlay-title="Move window down" { move-window-down; }

    // Column layout
    Mod+R hotkey-overlay-title="Cycle column width" { switch-preset-column-width; }
    Mod+C hotkey-overlay-title="Centre column" { center-column; }
    Mod+Comma hotkey-overlay-title="Stack window into column" { consume-window-into-column; }
    Mod+Period hotkey-overlay-title="Pull window out of column" { expel-window-from-column; }
    Mod+Minus hotkey-overlay-title="Column narrower" { set-column-width "-10%"; }
    Mod+Equal hotkey-overlay-title="Column wider" { set-column-width "+10%"; }

    // Switch workspace
    Mod+1 hotkey-overlay-title="Rivendell, dev" { focus-workspace "rivendell"; }
    Mod+2 hotkey-overlay-title="Bree, browser" { focus-workspace "bree"; }
    Mod+3 hotkey-overlay-title="Mordor, gaming" { focus-workspace "mordor"; }
    Mod+4 hotkey-overlay-title="Gondor, notes" { focus-workspace "gondor"; }
    Mod+5 hotkey-overlay-title="The Shire, general" { focus-workspace "shire"; }
    Mod+WheelScrollDown cooldown-ms=150 hotkey-overlay-title="Next workspace" { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 hotkey-overlay-title="Previous workspace" { focus-workspace-up; }

    // Send window to workspace
    Mod+Shift+1 hotkey-overlay-title="To Rivendell" { move-window-to-workspace "rivendell"; }
    Mod+Shift+2 hotkey-overlay-title="To Bree" { move-window-to-workspace "bree"; }
    Mod+Shift+3 hotkey-overlay-title="To Mordor" { move-window-to-workspace "mordor"; }
    Mod+Shift+4 hotkey-overlay-title="To Gondor" { move-window-to-workspace "gondor"; }
    Mod+Shift+5 hotkey-overlay-title="To the Shire" { move-window-to-workspace "shire"; }

    // Scratchpad
    Mod+S hotkey-overlay-title="Show or leave scratchpad" { spawn "~/.config/niri/scripts/scratchpad.sh"; }
    Mod+Shift+S hotkey-overlay-title="Send window to scratchpad" { move-window-to-workspace "magic" focus=false; }

    // Volume and brightness
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Volume up" { spawn "wpctl" "set-volume" "-l" "1" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Volume down" { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true hotkey-overlay-title="Mute" { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true hotkey-overlay-title="Mute microphone" { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp allow-when-locked=true hotkey-overlay-title="Brightness up" { spawn "brightnessctl" "-e4" "-n2" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="Brightness down" { spawn "brightnessctl" "-e4" "-n2" "set" "5%-"; }

    // Media
    XF86AudioNext allow-when-locked=true hotkey-overlay-title="Next track" { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true hotkey-overlay-title="Previous track" { spawn "playerctl" "previous"; }
    XF86AudioPlay allow-when-locked=true hotkey-overlay-title="Play or pause" { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true hotkey-overlay-title="Play or pause" { spawn "playerctl" "play-pause"; }
}

// Realm effects, written by palantir-realms.py; absent unless a low-effects realm is active.
// Last, so it overrides the settings above. Variables are not expanded, so this uses the uid.
include optional=true "/run/user/1000/palantir-niri-realm.kdl"
